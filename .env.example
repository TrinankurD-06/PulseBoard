# ---------- Shared ----------
NODE_ENV=development
# directConnection=true lets the driver talk to the single-node replica set from the host
MONGODB_URI=mongodb://localhost:27017/pulseboard?replicaSet=rs0&directConnection=true
LOG_LEVEL=info
# Allows 10s check intervals (instead of min 30s) for live demos
DEMO_MODE=true
# Allows monitoring private/loopback IPs (needed for the local demo-target). Keep false in prod.
ALLOW_PRIVATE_TARGETS=true

# ---------- API ----------
API_PORT=4000
# api: serve the API only (run the worker app as a second process).
# combined: this process also runs the worker, for one-service hosting (render.yaml).
# AGENDA_MAX_CONCURRENCY (below) then limits its checks.
RUN_MODE=api
CLIENT_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor (12 is about 250ms per hash). Tests use 4 for speed.
BCRYPT_COST=12
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Set to true when the API sits behind a proxy (Render) so rate limiting sees real client IPs
TRUST_PROXY=false

# ---------- Sign in with Google / GitHub (optional) ----------
# A provider's button appears only when BOTH its id and secret are set. Callback URL to register
# (APP_URL, or DASHBOARD_URL when APP_URL is empty, + the path):
#   dev:  http://localhost:5173/api/v1/auth/oauth/<google|github>/callback
#   prod: https://<your-app-domain>/api/v1/auth/oauth/<google|github>/callback
# Google: https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID
#   (type "Web application"), add the callback under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> OAuth Apps -> New OAuth App,
#   "Authorization callback URL" = the callback above (one URL per app: use one app per environment).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: key for encrypting the stored GitHub access token (used by "Import from GitHub").
#   Any random string of 32+ characters (e.g. openssl rand -hex 32). Leave empty to derive it
#   from JWT_REFRESH_SECRET. Changing it only means users must sign in with GitHub again.
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---------- Worker ----------
WORKER_HEALTH_PORT=4002
AGENDA_MAX_CONCURRENCY=20
# Public URL of the client, used for "open dashboard" links in alerts
DASHBOARD_URL=http://localhost:5173
# Public URL of the web app, shown in the checker's User-Agent ("+APP_URL/bot").
# Leave empty to use DASHBOARD_URL.
APP_URL=

# ---------- Alerts ----------
# Email alerts go over an HTTPS API (they work on Render's free plan, which blocks SMTP). Set ONE key:
#   Brevo (https://brevo.com): sends to ANY address a user adds as an alert channel, from one sender
#     address you verify in Brevo (no domain needed). Free tier: 300 emails a day. Recommended.
#   Resend (https://resend.com): sends to any address only once you verify a domain; until then it
#     delivers only to your own Resend account email.
# If both are set, Brevo is used. With neither (local development), emails go to an auto-created
# Ethereal test inbox, with a preview link in the incident timeline.
BREVO_API_KEY=
RESEND_API_KEY=
# The sender of alert emails. With Brevo it must be an address verified in your Brevo account
# (Senders & IP -> Senders), for example PulseBoard <you@gmail.com>; with Resend, an address on a
# verified domain.
ALERT_FROM_EMAIL=PulseBoard <alerts@pulseboard.local>
# Optional SMTP fallback, used only while neither key is set. Leave these out to use Ethereal.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---------- Public demo ----------
# true: the demo user (demo@pulseboard.dev) is a read-only Viewer, the app shows a "Demo mode -
# read-only" banner, and the worker resets the demo workspace's sample data once a day. Set it on
# the hosted public demo; leave it false locally so the demo account can edit.
DEMO_READ_ONLY=false
# The account that owns the demo workspace while DEMO_READ_ONLY=true. Empty: a login-less owner
# account (demo-owner@pulseboard.dev) is created. If the email belongs to an existing account, that
# account becomes the owner.
DEMO_OWNER_EMAIL=

# ---------- Admin panel ----------
# The administrator: every user, and a button to stop or start their monitors. Both must be set (the
# password at least 8 characters) or there is no admin. The API creates the account at start-up and
# keeps its password in line with ADMIN_PASSWORD. Sign in with them on the normal login page, then open
# "Admin". On a real deployment set your own values as secrets on the host.
# These values are the TEMPORARY evaluation admin published in the README: remove them (or change the
# password) once the evaluation is over, and never reuse a real password here.
ADMIN_EMAIL=admin@pulseboard.com
ADMIN_PASSWORD=admin123

# ---------- Seed ----------
# Optional: the seed script creates an alert channel from these if set
SEED_DISCORD_WEBHOOK_URL=
SEED_SLACK_WEBHOOK_URL=
SEED_ALERT_EMAIL=
# Public URL of the deployed demo-target (production). Locally: http://localhost:DEMO_TARGET_PORT/
SEED_DEMO_TARGET_URL=
# Seed the demo-target, heartbeat and agent monitors? Default: yes for a local database, no for a
# hosted one (they need the local demo-target). true/false overrides.
SEED_LOCAL_DEMO=
# Public URL of the API (production), written to apps/demo-target/.pulseboard-demo.json for the
# agent and the heartbeat script. Locally: http://localhost:API_PORT/api/v1
SEED_API_URL=

# ---------- Demo target ----------
DEMO_TARGET_PORT=4011

# ---------- Client (Vite; must be prefixed VITE_) ----------
VITE_API_URL=/api/v1
VITE_SOCKET_URL=http://localhost:4000
